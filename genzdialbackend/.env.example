# ===== Backend environment variables =====
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string
# - Local dev: leave blank to use 127.0.0.1 (or fallback embedded MongoMemoryServer)
# - Production (Vercel): MUST be a real MongoDB Atlas URI, e.g.
#   mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/watchstore?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/watchstore

# Default admin (created on first boot if missing)
ADMIN_EMAIL=admin@genzdial.com
ADMIN_PASSWORD=admin123

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-in-production

# Allowed CORS origins (comma-separated). Use '*' to allow any.
# Local dev defaults already cover http://localhost:5173 and :4173 if this is empty.
# Production example:
# CLIENT_URL=https://genzdialfrontend.vercel.app,https://www.yourdomain.com
CLIENT_URL=
